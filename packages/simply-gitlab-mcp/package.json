{
  "name": "@simplysf/simply-gitlab-mcp",
  "description": "Model Context Protocol server exposing GitLab to AI agents, built on @simplysf/simply-gitlab-core",
  "version": "0.5.0",
  "author": "@ClayChipps",
  "homepage": "https://github.com/SimplySF/simply-gitlab",
  "bugs": "https://github.com/SimplySF/simply-gitlab/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimplySF/simply-gitlab",
    "directory": "packages/simply-gitlab-mcp"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/docs",
    "/lib",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gitlab",
    "ci",
    "merge-requests",
    "simply"
  ],
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "type": "module",
  "types": "./lib/index.d.ts",
  "bin": {
    "simply-gitlab-mcp": "./bin/run.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@oclif/core": "^4.11.2",
    "@simplysf/simply-gitlab-core": "workspace:^0.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "oclif": "^4.23.0",
    "shx": "^0.4.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "compile": "wireit",
    "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
    "format": "wireit",
    "lint": "wireit",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "pnpm run compile && oclif manifest",
    "test": "wireit",
    "test:coverage": "wireit",
    "test:only": "wireit",
    "test:watch": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "compile",
        "lint"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "../simply-gitlab-core:compile"
      ]
    },
    "format": {
      "command": "prettier --write \"+(src|test)/**/*.+(ts|js|json)\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src test --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "**/.eslint*",
        "**/tsconfig.json",
        "../../eslint.config.mjs",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-gitlab-core:compile"
      ]
    },
    "test": {
      "dependencies": [
        "test:compile",
        "test:only",
        "lint"
      ]
    },
    "test:compile": {
      "command": "tsc -p \"./test\" --pretty",
      "files": [
        "test/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-gitlab-core:compile"
      ]
    },
    "test:only": {
      "command": "vitest run --project simply-gitlab-mcp",
      "env": {
        "FORCE_COLOR": "2"
      },
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts"
      ],
      "output": [],
      "dependencies": [
        "../simply-gitlab-core:compile"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage --project simply-gitlab-mcp",
      "env": {
        "FORCE_COLOR": "2"
      },
      "dependencies": [
        "../simply-gitlab-core:compile"
      ],
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts"
      ],
      "output": [
        "coverage/**"
      ]
    },
    "test:watch": {
      "command": "vitest watch --project simply-gitlab-mcp",
      "env": {
        "FORCE_COLOR": "2"
      },
      "dependencies": [
        "../simply-gitlab-core:compile"
      ],
      "service": true
    }
  },
  "oclif": {
    "bin": "simply",
    "commands": "./lib/commands",
    "topicSeparator": " ",
    "topics": {
      "gitlab": {
        "description": "Work with GitLab."
      }
    }
  }
}
