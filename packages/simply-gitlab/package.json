{
  "name": "@simplysf/simply-gitlab",
  "description": "Command-line interface for working with GitLab",
  "version": "0.3.0",
  "author": "@ClayChipps",
  "homepage": "https://github.com/SimplySF/simply-gitlab",
  "bugs": "https://github.com/SimplySF/simply-gitlab/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimplySF/simply-gitlab",
    "directory": "packages/simply-gitlab"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/lib",
    "/oclif.lock",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "oclif",
    "gitlab",
    "ci",
    "merge-requests",
    "simply"
  ],
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "type": "module",
  "types": "./lib/index.d.ts",
  "bin": {
    "simply": "./bin/run.js"
  },
  "oclif": {
    "additionalVersionFlags": [
      "-v"
    ],
    "additionalHelpFlags": [
      "-h"
    ],
    "bin": "simply",
    "commands": "./lib/commands",
    "devPlugins": [
      "@oclif/plugin-command-snapshot"
    ],
    "flexibleTaxonomy": true,
    "plugins": [],
    "repositoryPrefix": "<%- repo %>/blob/@simplysf/simply-gitlab@<%- version %>/packages/simply-gitlab/<%- commandPath %>",
    "topicSeparator": " ",
    "topics": {
      "gitlab": {
        "description": "Work with GitLab."
      },
      "gitlab:project": {
        "description": "Read project metadata."
      },
      "gitlab:file": {
        "description": "Read and write repository files."
      },
      "gitlab:branch": {
        "description": "List and create branches."
      },
      "gitlab:commit": {
        "description": "Read history and commit changes."
      },
      "gitlab:mr": {
        "description": "Read and manage merge requests."
      },
      "gitlab:tag": {
        "description": "List repository tags."
      },
      "gitlab:release": {
        "description": "List releases."
      },
      "gitlab:ci": {
        "description": "Inspect CI/CD jobs, variables, and environments."
      },
      "gitlab:ci:job": {
        "description": "List CI jobs and read their logs."
      },
      "gitlab:ci:variable": {
        "description": "List CI/CD variables."
      },
      "gitlab:ci:environment": {
        "description": "List deployment environments."
      },
      "gitlab:config": {
        "description": "Hold many projects to one baseline configuration."
      }
    }
  },
  "dependencies": {
    "@oclif/core": "^4.11.2",
    "@simplysf/simply-gitlab-core": "workspace:^0.3.0"
  },
  "devDependencies": {
    "@oclif/plugin-command-snapshot": "^5.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "compile": "wireit",
    "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
    "format": "wireit",
    "lint": "wireit",
    "readme": "oclif readme --no-aliases",
    "test": "wireit",
    "test:coverage": "wireit",
    "test:only": "wireit",
    "test:watch": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "command-snapshot",
        "compile",
        "lint"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "../simply-gitlab-core:compile"
      ]
    },
    "format": {
      "command": "prettier --write \"+(src|test)/**/*.+(ts|js|json)|command-snapshot.json\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "command-snapshot.json",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src test --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "**/.eslint*",
        "**/tsconfig.json",
        "../../eslint.config.mjs",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-gitlab-core:compile"
      ]
    },
    "test": {
      "dependencies": [
        "test:compile",
        "test:only",
        "lint"
      ]
    },
    "command-snapshot": {
      "command": "node --loader ts-node/esm --no-warnings=ExperimentalWarning \"./bin/dev.js\" snapshot:generate && prettier --write command-snapshot.json",
      "files": [
        "src/**/*.ts"
      ],
      "output": [
        "command-snapshot.json"
      ],
      "dependencies": [
        "compile"
      ]
    },
    "test:compile": {
      "command": "tsc -p \"./test\" --pretty",
      "files": [
        "test/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-gitlab-core:compile"
      ]
    },
    "test:only": {
      "command": "vitest run --project simply-gitlab",
      "env": {
        "FORCE_COLOR": "2"
      },
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts",
        "!*.nut.ts"
      ],
      "output": [],
      "dependencies": [
        "../simply-gitlab-core:compile"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage --project simply-gitlab",
      "env": {
        "FORCE_COLOR": "2"
      },
      "dependencies": [
        "../simply-gitlab-core:compile"
      ],
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts",
        "!*.nut.ts"
      ],
      "output": [
        "coverage/**"
      ]
    },
    "test:watch": {
      "command": "vitest watch --project simply-gitlab",
      "env": {
        "FORCE_COLOR": "2"
      },
      "dependencies": [
        "../simply-gitlab-core:compile"
      ],
      "service": true
    }
  }
}
